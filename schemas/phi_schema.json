{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsdkijc-dev/indonesia-labour-justice-observatory/schemas/phi_schema.json",
  "title": "ILJO PHI Judgment Record Schema v1.0",
  "type": "object",
  "required": [
    "record_id",
    "case_number",
    "court_name",
    "court_level",
    "case_category",
    "dispute_type",
    "registration_date",
    "decision_date",
    "publication_date",
    "plaintiff_type",
    "defendant_type",
    "worker_representation",
    "employer_representation",
    "claim_summary",
    "judgment_outcome",
    "remedy_type",
    "appeal_status",
    "execution_status",
    "source_url",
    "source_retrieved_at",
    "document_sha256",
    "extraction_method",
    "extraction_confidence",
    "validation_status",
    "publication_status"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^ILJO-[0-9]{4}-[0-9]{4,}$"},
    "case_number": {"type": "string", "minLength": 5},
    "court_name": {"type": "string", "minLength": 3},
    "court_level": {"type": "string", "enum": ["PHI_First_Instance", "MA_Cassation", "Unknown"]},
    "case_category": {"type": "string", "minLength": 2},
    "dispute_type": {"type": "string", "enum": ["Rights dispute", "Interest dispute", "Termination dispute", "Inter-union dispute", "Unknown"]},
    "registration_date": {"type": ["string", "null"], "format": "date"},
    "decision_date": {"type": ["string", "null"], "format": "date"},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "plaintiff_type": {"type": "string", "enum": ["Worker", "Union", "Employer", "Employer Association", "Multiple", "Unknown"]},
    "defendant_type": {"type": "string", "enum": ["Worker", "Union", "Employer", "Employer Association", "Multiple", "Unknown"]},
    "worker_representation": {"type": "string", "enum": ["Advocate", "Union", "Legal Aid", "Self-represented", "Unknown"]},
    "employer_representation": {"type": "string", "enum": ["Advocate", "In-house Legal", "Self-represented", "Unknown"]},
    "claim_summary": {"type": "string", "minLength": 5},
    "judgment_outcome": {"type": "string", "enum": ["Granted", "Partly granted", "Rejected", "Dismissed on procedural grounds", "Other", "Unknown"]},
    "remedy_type": {"type": "string"},
    "appeal_status": {"type": "string", "enum": ["Not appealed", "Appealed to cassation", "Cassation decided", "Not appealable", "Unknown", "Not observable"]},
    "execution_status": {"type": "string", "enum": ["Confirmed executed", "Confirmed partially executed", "Confirmed not executed", "Unknown", "Not observable"]},
    "source_url": {"type": "string", "format": "uri"},
    "source_retrieved_at": {"type": "string", "format": "date-time"},
    "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extraction_method": {"type": "string", "enum": ["rule_based", "ai_assisted", "hybrid", "manual_verified", "synthetic"]},
    "extraction_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "validation_status": {"type": "string", "enum": ["Validated", "Pending", "Flagged", "Rejected"]},
    "publication_status": {"type": "string", "enum": ["Approved", "Pending_Review", "Restricted", "Synthetic_Only"]}
  },
  "additionalProperties": false
}
